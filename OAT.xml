<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <licensefile></licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="copyright" name="AProf contributors" path="skills/tool-ops-optimize/.*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc="AProf contributed runtime and tooling"/>
                <policyitem type="license" name="CANN-2.0" path=".*" rule="may" group="defaultGroup" filefilter="defaultPolicyFilter" desc=""/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc=""/>
                <policyitem type="filetype" name="!binary" path=".*" rule="must" group="defaultGroup" filefilter="binaryFileTypePolicyFilter" desc=""/>
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility,license header policies">
                <filteritem type="filename" name="classify_rule.yaml" desc="recognize code owner"/>
                <filteritem type="filename" name="OWNERS" desc="Describe commite owner"/>
                <filteritem type="filename" name="OAT.xml" desc="Describe commite owner"/>
                <filteritem type="filename" name=".gitmodules" desc="git submodule "/>
                <filteritem type="filename" name="*.info" desc="info file"/>
                <filteritem type="filename" name="*.csv" desc="csv file"/>
                <filteritem type="filename" name="*.jsonl" desc="JSON Lines data file"/>
                <filteritem type="filename" name="*.yaml" desc="yaml file"/>
                <filteritem type="filename" name="*.xml" desc="xml file"/>
                <filteritem type="filename" name=".gitkeeper" desc="git keeper "/>
                <filteritem type="filename" name="Third_Party_Open_Source_Softerware_Notice" desc="third party license "/>
            </filefilter>
            <filefilter name="copyrightPolicyFilter" desc="Filters for copyright header policies">
                <filteritem type="filename" name="classify_rule.yaml" desc="recognize code owner"/>
                <filteritem type="filename" name="OWNERS" desc="Describe commite owner"/>
                <filteritem type="filename" name=".gitmodules" desc="git submodule "/>
                <filteritem type="filename" name=".gitkeeper" desc="git keeper "/>
                <filteritem type="filename" name="*.csv" desc="csv file"/>
                <filteritem type="filename" name="*.jsonl" desc="JSON Lines data file"/>
                <filteritem type="filename" name="*.yaml" desc="yaml file"/>
                <filteritem type="filename" name="*.xml" desc="xml file"/>
                <filteritem type="filename" name="*.info" desc="info file"/>
                <filteritem type="filename" name="Third_Party_Open_Source_Softerware_Notice" desc="third party license "/>
            </filefilter>
            <filefilter name="licenseFileNamePolicyFilter" desc="Filters for LICENSE file policies">
            </filefilter>
            <filefilter name="readmeFileNamePolicyFilter" desc="Filters for README file policies">
            </filefilter>
            <filefilter name="readmeOpenSourcefileNamePolicyFilter" desc="Filters for README.OpenSource file policies">
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies">
                <filteritem type="filename" name="*.png" desc="documentation images"/>
            </filefilter>

        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="CANN License" desc="License for CANN Open Software">
