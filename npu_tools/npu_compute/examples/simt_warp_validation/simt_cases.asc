// Ten independently compiled, deterministic SIMT kernel tests.
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#ifndef CASE_ID
#error CASE_ID must be defined
#endif
#if CASE_ID < 1 || CASE_ID > 10
#error CASE_ID must be between 1 and 10
#endif

constexpr uint32_t kThreads = 256;
constexpr uint32_t kElements = CASE_ID == 10 ? 513 : 1024;

__simt_vf__ __launch_bounds__(kThreads) inline void simt_case(
    __gm__ float* a, __gm__ float* b, __gm__ float* out, uint32_t count)
{
    const uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= count) return;
#if CASE_ID == 1
    out[i] = a[i] + b[i];
#elif CASE_ID == 2
    out[i] = a[i] * b[i];
#elif CASE_ID == 3
    out[i] = a[i] > 0.0f ? a[i] : 0.0f;
#elif CASE_ID == 4
    const float value = a[i];
    out[i] = value < -3.0f ? -3.0f : (value > 3.0f ? 3.0f : value);
#elif CASE_ID == 5
    out[i] = (i & 1U) == 0 ? a[i] + b[i] : a[i] - b[i];
#elif CASE_ID == 6
    out[i] = a[count - 1U - i];
#elif CASE_ID == 7
    out[count - 1U - i] = a[i];
#elif CASE_ID == 8
    out[i] = a[i] + a[(i + 1U) % count];
#elif CASE_ID == 9
    float value = a[i];
    for (uint32_t j = 0; j < 4; ++j) value += b[i];
    out[i] = value;
#elif CASE_ID == 10
    out[i] = a[i] + b[i];
#endif
}

__global__ __aicore__ void case_kernel(
    __gm__ float* a, __gm__ float* b, __gm__ float* out, uint32_t count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    asc_vf_call<simt_case>(dim3(kThreads), a, b, out, count);
}

float Expected(const std::vector<float>& a, const std::vector<float>& b, uint32_t i)
{
#if CASE_ID == 1 || CASE_ID == 10
    return a[i] + b[i];
#elif CASE_ID == 2
    return a[i] * b[i];
#elif CASE_ID == 3
    return a[i] > 0.0f ? a[i] : 0.0f;
#elif CASE_ID == 4
    return std::max(-3.0f, std::min(3.0f, a[i]));
#elif CASE_ID == 5
    return (i & 1U) == 0 ? a[i] + b[i] : a[i] - b[i];
#elif CASE_ID == 6 || CASE_ID == 7
    return a[kElements - 1U - i];
#elif CASE_ID == 8
    return a[i] + a[(i + 1U) % kElements];
#else
    return a[i] + 4.0f * b[i];
#endif
}

bool CheckAcl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) return true;
    std::fprintf(stderr, "[case %02d] %s failed: %d\n", CASE_ID, operation, status);
    return false;
}

int main()
{
    std::printf("[case %02d] preparing %u elements\n", CASE_ID, kElements);
    std::fflush(stdout);
    std::vector<float> a(kElements), b(kElements), out(kElements);
    for (uint32_t i = 0; i < kElements; ++i) {
        a[i] = static_cast<float>(static_cast<int>(i % 17U) - 8);
        b[i] = static_cast<float>(static_cast<int>(i % 7U) - 3);
    }
    const size_t bytes = static_cast<size_t>(kElements) * sizeof(float);
    bool initialized = false, deviceSet = false, ok = false;
    aclrtStream stream = nullptr;
    void* devA = nullptr; void* devB = nullptr; void* devOut = nullptr;
    do {
        if (!CheckAcl(aclInit(nullptr), "aclInit")) break;
        initialized = true;
        if (!CheckAcl(aclrtSetDevice(0), "aclrtSetDevice")) break;
        deviceSet = true;
        if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) break;
        if (!CheckAcl(aclrtMalloc(&devA, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc a")) break;
        if (!CheckAcl(aclrtMalloc(&devB, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc b")) break;
        if (!CheckAcl(aclrtMalloc(&devOut, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc output")) break;
        if (!CheckAcl(aclrtMemcpy(devA, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy a")) break;
        if (!CheckAcl(aclrtMemcpy(devB, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy b")) break;
        if (!CheckAcl(aclrtMemset(devOut, bytes, 0, bytes), "clear output")) break;
        std::printf("[case %02d] launching SIMT kernel\n", CASE_ID);
        std::fflush(stdout);
        case_kernel<<<(kElements + kThreads - 1U) / kThreads, 0, stream>>>(
            static_cast<float*>(devA), static_cast<float*>(devB), static_cast<float*>(devOut), kElements);
        if (!CheckAcl(aclrtSynchronizeStream(stream), "synchronize")) break;
        if (!CheckAcl(aclrtMemcpy(out.data(), bytes, devOut, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output")) break;
        ok = true;
        for (uint32_t i = 0; i < kElements; ++i) {
            const float expected = Expected(a, b, i);
            if (!std::isfinite(out[i]) || std::fabs(out[i] - expected) > 0.00001f) {
                std::fprintf(stderr, "[case %02d] mismatch index=%u actual=%f expected=%f\n",
                    CASE_ID, i, out[i], expected);
                ok = false;
                break;
            }
        }
    } while (false);
    if (devOut != nullptr) (void)aclrtFree(devOut);
    if (devB != nullptr) (void)aclrtFree(devB);
    if (devA != nullptr) (void)aclrtFree(devA);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    if (deviceSet) (void)aclrtResetDevice(0);
    if (initialized) (void)aclFinalize();
    std::printf("[case %02d] %s\n", CASE_ID, ok ? "PASS" : "FAIL");
    return ok ? EXIT_SUCCESS : EXIT_FAILURE;
}
